MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DB_PASSWORD=replace-with-a-local-application-password
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-base64-of-32-random-bytes
ADMIN_EMAIL=admin@example.test
# At least 12 characters; used only when the users table is empty.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
